# OPENAI_API_KEY: 打卡卡影像辨識所用的 OpenAI API 金鑰（Server 端，絕不進前端）
OPENAI_API_KEY=""

# OPENAI_MODEL: 使用的視覺模型 ID，未設定時 OCR 會回 OCR_NOT_CONFIGURED
OPENAI_MODEL=""

# OPENAI_BASE_URL: 留空則直連 OpenAI；走 Cloudflare AI Gateway 時填閘道位址
# 例：https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_name>/openai
OPENAI_BASE_URL=""

# CF_AIG_TOKEN: 僅在 Cloudflare AI Gateway 啟用 Authenticated Gateway 時需要
CF_AIG_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Required for Google Identity Services (GSI) client-side authentication.
VITE_GOOGLE_CLIENT_ID=""

# GOOGLE_SHEETS_SPREADSHEET_ID: Friends Alpha Google Sheet ID (Server-side)
GOOGLE_SHEETS_SPREADSHEET_ID=""

# VITE_APP_MODE: Application Mode (default: alpha)
VITE_APP_MODE="alpha"
