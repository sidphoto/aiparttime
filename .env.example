# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Required for Google Identity Services (GSI) client-side authentication.
VITE_GOOGLE_CLIENT_ID=""

# GOOGLE_SHEETS_SPREADSHEET_ID: Friends Alpha Google Sheet ID (Server-side)
GOOGLE_SHEETS_SPREADSHEET_ID=""

# VITE_APP_MODE: Application Mode (default: alpha)
VITE_APP_MODE="alpha"
